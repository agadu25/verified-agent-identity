name: Verify Human Identity

on:
  workflow_dispatch:

jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: '20'

      - name: Install dependencies (di folder scripts)
        run: |
          cd scripts
          npm ci

      - name: Step 2 - Create new Ethereum Identity
        run: node scripts/createNewEthereumIdentity.js

      - name: Step 3 - Link Human to Agent (INI YANG PENTING!)
        run: |
          node scripts/manualLinkHumanToAgent.js --challenge '{"name": "hendrii", "description": "hendrii AI Agent"}'
